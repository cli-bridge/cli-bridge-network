{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-cli.dev/schemas/agent-cli-card.schema.json",
  "title": "AgentCliCard",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "agent-cli.dev/v1alpha1" },
    "kind": { "const": "AgentCliCard" },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "homepage": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "runtime": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["stdio", "pty", "http", "mcp", "agent"] },
            "command": { "type": "string" },
            "cwdPolicy": { "enum": ["workspace", "manifest", "fixed", "none"] }
          },
          "additionalProperties": true
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/command" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "command": {
      "type": "object",
      "required": ["id", "title", "argv"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "inputSchema": { "type": "object" },
        "output": {
          "type": "object",
          "properties": {
            "mediaType": { "type": "string" },
            "parser": { "type": "string" }
          },
          "additionalProperties": true
        },
        "policy": {
          "type": "object",
          "properties": {
            "risk": { "enum": ["read", "write-workspace", "privileged", "external-network"] },
            "requiresConfirmation": { "type": "boolean" },
            "network": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
