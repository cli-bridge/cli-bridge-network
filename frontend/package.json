{
  "name": "frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Desktop frontend for CLI Bridge Network Workflow Studio.",
  "main": "electron/main.cjs",
  "scripts": {
    "app:build": "npm run build",
    "app:dev": "node scripts/dev-electron.mjs",
    "app:start": "npm run build && electron .",
    "check": "vue-tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "litegraph.js": "^0.7.18",
    "lucide-vue-next": "^0.468.0",
    "vite": "^5.4.21",
    "vue": "^3.5.24",
    "vue-tsc": "^2.2.12"
  },
  "devDependencies": {
    "electron": "^39.0.0"
  }
}
