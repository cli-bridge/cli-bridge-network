{
  "apiVersion": "bridge.dev/v1alpha1",
  "kind": "ToolManifest",
  "metadata": {
    "id": "ffprobe.inspect",
    "title": "ffprobe Inspect"
  },
  "spec": {
    "transport": {
      "kind": "stdio",
      "command": "ffprobe",
      "argsTemplate": ["-v", "error", "-show_format", "-show_streams", "-of", "json"],
      "cwdPolicy": "workspace"
    },
    "policy": {
      "risk": "read",
      "requiresConfirmation": false,
      "network": "deny"
    },
    "output": {
      "parserRef": "ffprobe.json",
      "verified": true
    }
  }
}

