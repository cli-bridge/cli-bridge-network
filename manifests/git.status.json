{
  "apiVersion": "bridge.dev/v1alpha1",
  "kind": "ToolManifest",
  "metadata": {
    "id": "git.status",
    "title": "Git Status"
  },
  "spec": {
    "transport": {
      "kind": "stdio",
      "command": "git",
      "argsTemplate": ["status", "--short"],
      "cwdPolicy": "workspace"
    },
    "policy": {
      "risk": "read",
      "requiresConfirmation": false,
      "network": "deny"
    },
    "output": {
      "parserRef": "git.status.short",
      "verified": true
    }
  }
}

