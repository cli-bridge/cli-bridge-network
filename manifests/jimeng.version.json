{
  "apiVersion": "bridge.dev/v1alpha1",
  "kind": "ToolManifest",
  "metadata": {
    "id": "jimeng.version",
    "title": "Jimeng/Dreamina CLI Version",
    "labels": {
      "adapter": "direct-cli",
      "profile": "jimeng",
      "vendor": "dreamina",
      "category": "media-generation"
    },
    "annotations": {
      "cbn.adapter.profile": "jimeng",
      "cbn.adapter.action": "version",
      "cbn.parser_fixture": "parser_fixtures/direct-cli.raw.probes.json",
      "cbn.thread.evidence": "dreamina version returned commit 46b5b0e and build time 2026-06-03T19:39:25Z",
      "cbn.auth_gate": "none for version probe"
    }
  },
  "spec": {
    "transport": {
      "kind": "stdio",
      "command": "python",
      "argsTemplate": [
        "-m",
        "cbn_tools.external_cli",
        "jimeng",
        "version"
      ],
      "cwdPolicy": "workspace",
      "timeoutSeconds": 20
    },
    "policy": {
      "risk": "read",
      "requiresConfirmation": false,
      "network": "deny"
    },
    "output": {
      "parserRef": "direct-cli.typed",
      "verified": true
    }
  }
}
