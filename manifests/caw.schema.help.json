{
  "apiVersion": "bridge.dev/v1alpha1",
  "kind": "ToolManifest",
  "metadata": {
    "id": "caw.schema.help",
    "title": "Cobo Agentic Wallet Schema Help",
    "labels": {
      "adapter": "direct-cli",
      "profile": "caw",
      "vendor": "cobo",
      "category": "wallet"
    },
    "annotations": {
      "cbn.adapter.profile": "caw",
      "cbn.adapter.action": "schema-help",
      "cbn.discovery.source": "caw --help advertised schema command",
      "cbn.output_contract": "future parser should promote command JSON schema into typed CBN capabilities"
    }
  },
  "spec": {
    "transport": {
      "kind": "stdio",
      "command": "python",
      "argsTemplate": [
        "-m",
        "cbn_tools.external_cli",
        "caw",
        "schema-help"
      ],
      "cwdPolicy": "workspace",
      "timeoutSeconds": 20
    },
    "policy": {
      "risk": "read",
      "requiresConfirmation": false,
      "network": "deny"
    },
    "output": {
      "parserRef": "raw.text",
      "verified": false
    }
  }
}
