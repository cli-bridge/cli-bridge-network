{
  "apiVersion": "bridge.dev/v1alpha1",
  "kind": "ToolManifest",
  "metadata": {
    "id": "caw.help",
    "title": "Cobo Agentic Wallet Help",
    "labels": {
      "adapter": "direct-cli",
      "profile": "caw",
      "vendor": "cobo",
      "category": "wallet"
    },
    "annotations": {
      "cbn.adapter.profile": "caw",
      "cbn.adapter.action": "help",
      "cbn.parser_fixture": "parser_fixtures/direct-cli.raw.probes.json",
      "cbn.thread.evidence": "caw --help listed wallet, pact, tx, payment, fetch, schema and status command surfaces",
      "cbn.auth_gate": "none for help probe"
    }
  },
  "spec": {
    "transport": {
      "kind": "stdio",
      "command": "python",
      "argsTemplate": [
        "-m",
        "cbn_tools.external_cli",
        "caw",
        "help"
      ],
      "cwdPolicy": "workspace",
      "timeoutSeconds": 20
    },
    "policy": {
      "risk": "read",
      "requiresConfirmation": false,
      "network": "deny"
    },
    "output": {
      "parserRef": "raw.text",
      "verified": true
    }
  }
}
