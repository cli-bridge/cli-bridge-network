{
  "apiVersion": "bridge.dev/v1alpha1",
  "kind": "ToolManifest",
  "metadata": {
    "id": "jimeng.user_credit",
    "title": "Jimeng/Dreamina User Credit",
    "labels": {
      "adapter": "direct-cli",
      "profile": "jimeng",
      "vendor": "dreamina",
      "category": "media-generation"
    },
    "annotations": {
      "cbn.adapter.profile": "jimeng",
      "cbn.adapter.action": "user-credit",
      "cbn.auth_gate": "requires Dreamina OAuth login state",
      "cbn.output_contract": "future parser should extract available credit and account status"
    }
  },
  "spec": {
    "transport": {
      "kind": "stdio",
      "command": "python",
      "argsTemplate": [
        "-m",
        "cbn_tools.external_cli",
        "jimeng",
        "user-credit"
      ],
      "cwdPolicy": "workspace",
      "timeoutSeconds": 60
    },
    "policy": {
      "risk": "external-network",
      "requiresConfirmation": true,
      "network": "requires-confirmation"
    },
    "output": {
      "parserRef": "raw.text",
      "verified": false
    }
  }
}
