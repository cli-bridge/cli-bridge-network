{
  "apiVersion": "bridge.dev/v1alpha1",
  "kind": "ToolManifest",
  "metadata": {
    "id": "jimeng.query_result",
    "title": "Jimeng/Dreamina Query Result",
    "labels": {
      "adapter": "direct-cli",
      "profile": "jimeng",
      "vendor": "dreamina",
      "category": "media-generation"
    },
    "annotations": {
      "cbn.adapter.profile": "jimeng",
      "cbn.adapter.action": "query-result",
      "cbn.auth_gate": "requires Dreamina OAuth login state",
      "cbn.workflow_hint": "poll a submitted Dreamina async task by submit_id after media.task.submitted",
      "cbn.output_contract": "direct-cli.typed extracts submit_id, task status, result URLs, and generated media result counts",
      "cbn.parser_fixture": "parser_fixtures/direct-cli.typed.probes.json"
    }
  },
  "spec": {
    "transport": {
      "kind": "stdio",
      "command": "python",
      "argsTemplate": [
        "-m",
        "cbn_tools.external_cli",
        "jimeng",
        "query-result"
      ],
      "cwdPolicy": "workspace",
      "timeoutSeconds": 120
    },
    "policy": {
      "risk": "external-network",
      "requiresConfirmation": true,
      "network": "requires-confirmation"
    },
    "output": {
      "parserRef": "direct-cli.typed",
      "verified": true
    }
  }
}
