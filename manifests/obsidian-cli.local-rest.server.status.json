{
  "apiVersion": "bridge.dev/v1alpha1",
  "kind": "ToolManifest",
  "metadata": {
    "id": "obsidian-cli.local-rest.server.status",
    "title": "Obsidian Local REST Server Status",
    "labels": {
      "adapter": "direct-cli",
      "profile": "obsidian-cli",
      "vendor": "obsidian",
      "category": "knowledge-base"
    },
    "annotations": {
      "cbn.adapter.profile": "obsidian-cli",
      "cbn.adapter.action": "local-rest-server-status",
      "cbn.auth_gate": "requires Obsidian Local REST API plugin and API key",
      "cbn.output_contract": "future parser should extract server availability and vault/session metadata"
    }
  },
  "spec": {
    "transport": {
      "kind": "stdio",
      "command": "python",
      "argsTemplate": [
        "-m",
        "cbn_tools.external_cli",
        "obsidian-cli",
        "local-rest-server-status"
      ],
      "cwdPolicy": "workspace",
      "timeoutSeconds": 30
    },
    "policy": {
      "risk": "read",
      "requiresConfirmation": false,
      "network": "localhost"
    },
    "output": {
      "parserRef": "raw.text",
      "verified": false
    }
  }
}
