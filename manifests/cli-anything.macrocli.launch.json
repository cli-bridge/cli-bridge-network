{
  "apiVersion": "bridge.dev/v1alpha1",
  "kind": "ToolManifest",
  "metadata": {
    "id": "cli-anything.macrocli.launch",
    "title": "CLI-Anything MacroCLI",
    "labels": {
      "plugin": "cli-anything",
      "harness": "macrocli",
      "category": "automation",
      "source": "harness"
    },
    "annotations": {
      "cli-anything.display_name": "MacroCLI",
      "cli-anything.version": "1.0.0",
      "cli-anything.description": "Layered macro runtime that converts GUI workflows into parameterized, agent-callable macros — record once, run anywhere via CLI with backend routing across native APIs, file transforms, accessibility controls, and visual template matching",
      "cli-anything.homepage": "https://github.com/HKUDS/CLI-Anything/tree/main/macrocli",
      "cli-anything.install_cmd": "pip install git+https://github.com/HKUDS/CLI-Anything.git#subdirectory=macrocli/agent-harness",
      "cli-anything.entry_point": "cli-anything-macrocli",
      "cli-anything.skill_md": "macrocli/agent-harness/cli_anything/macrocli/skills/SKILL.md",
      "cli-anything.contributors": "[{\"name\": \"haorui-harry\", \"url\": \"https://github.com/haorui-harry\"}]",
      "cli-anything.policy_inference": "[\"runtime appears to generate, edit, render, convert, or export artifacts\"]"
    }
  },
  "spec": {
    "transport": {
      "kind": "stdio",
      "command": "cli-hub",
      "argsTemplate": [
        "launch",
        "macrocli",
        "--"
      ],
      "cwdPolicy": "workspace",
      "timeoutSeconds": 600
    },
    "policy": {
      "risk": "write-workspace",
      "requiresConfirmation": false,
      "network": "deny"
    },
    "output": {
      "parserRef": "cli-anything.raw",
      "verified": false
    }
  }
}
