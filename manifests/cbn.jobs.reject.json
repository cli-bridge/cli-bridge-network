{
  "apiVersion": "bridge.dev/v1alpha1",
  "kind": "ToolManifest",
  "metadata": {
    "id": "cbn.jobs.reject",
    "title": "ERC-8183 Job Reject (terminal)",
    "labels": {"profile": "cbn-jobs", "category": "job-commerce", "role": "evaluator"},
    "annotations": {"cbn.usage": "args=['<job_id>','--reason','<text>']. evaluation_pending -> rejected (TERMINAL). Use cbn.jobs.revision to rework. Onchain refund is caw.erc8183.reject."}
  },
  "spec": {
    "transport": {"kind": "stdio", "command": "python", "argsTemplate": ["-m", "cbn_jobs", "reject"], "cwdPolicy": "workspace", "timeoutSeconds": 30},
    "policy": {"risk": "read", "requiresConfirmation": false, "network": "deny"},
    "output": {"parserRef": "direct-cli.typed", "verified": true}
  }
}
